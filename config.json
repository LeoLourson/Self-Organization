{
  "agents": 5,
  "horizon": 4,
  "history_weeks": 52,
  "first_origin": 52,
  "worker_words": 250,
  "data": "data/series.csv",
  "subagent_type": "net-agent",
  "vote_profile": "sonnet_api",
  "judge_profile": "deepseek_pro",
  "api": {
    "max_tokens": 16000,
    "max_requests": 5000
  },
  "engines": {
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "key_env": "DEEPSEEK_API_KEY"
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1/",
      "key_env": "ANTHROPIC_API_KEY"
    },
    "local": {
      "base_url": "http://127.0.0.1:11434/v1",
      "key_env": "LOCAL_API_KEY"
    }
  },
  "profiles": {
    "deepseek": {
      "transport": "api",
      "engine": "deepseek",
      "model": "deepseek-flash",
      "settings": {}
    },
    "deepseek_pro": {
      "transport": "api",
      "engine": "deepseek",
      "model": "deepseek-v4-pro",
      "settings": {}
    },
    "sonnet_api": {
      "transport": "api",
      "engine": "anthropic",
      "model": "claude-sonnet-5-5",
      "settings": {}
    },
    "sonnet_sub": {
      "transport": "subagent",
      "engine": "claude-code",
      "model": "claude-sonnet-5-5",
      "settings": {}
    },
    "qwen_local": {
      "transport": "api",
      "engine": "local",
      "model": "qwen2.5:1.5b",
      "settings": {}
    }
  },
  "sandbox": {
    "paths": [
      "~/.claude/CLAUDE.md",
      "~/.claude/skills",
      "~/.claude/projects/c--Users-LeoLeon-Documents--------------------------------------------/memory"
    ],
    "disable_plugins": true
  }
}
