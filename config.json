{
  "agents": 5,
  "horizon": 4,
  "history_weeks": 52,
  "first_origin": 52,
  "worker_words": 150,
  "task_words": 60,
  "debrief_words": 90,
  "reason_words": 30,
  "control_repeats": 5,
  "report_quotes": 5,
  "data": "data/series.csv",
  "subagent_type": "net-agent",
  "vote_profile": "sonnet_api",
  "judge_profile": "judge",
  "api": {
    "max_tokens": 16000,
    "max_requests": 5000
  },
  "engines": {
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "key_env": "DEEPSEEK_API_KEY"
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1/",
      "key_env": "ANTHROPIC_API_KEY"
    },
    "local": {
      "base_url": "http://localhost:11434/v1",
      "base_url_env": "LOCAL_BASE_URL",
      "key_env": "LOCAL_API_KEY",
      "key_optional": true,
      "timeout": 600
    },
    "routerai": {
      "base_url": "https://routerai.ru/api/v1",
      "key_env": "ROUTERAI_API_KEY",
      "timeout": 600
    }
  },
  "profiles": {
    "deepseek": {
      "transport": "api",
      "engine": "deepseek",
      "model": "deepseek-flash",
      "settings": {}
    },
    "judge": {
      "transport": "api",
      "engine": "deepseek",
      "model": "deepseek-flash",
      "settings": {}
    },
    "deepseek_pro": {
      "transport": "api",
      "engine": "deepseek",
      "model": "deepseek-v4-pro",
      "settings": {}
    },
    "sonnet_api": {
      "transport": "api",
      "engine": "anthropic",
      "model": "claude-sonnet-5-5",
      "settings": {}
    },
    "sonnet_sub": {
      "transport": "subagent",
      "engine": "claude-code",
      "model": "claude-sonnet-5-5",
      "settings": {}
    },
    "qwen_local": {
      "transport": "api",
      "engine": "local",
      "model": "qwen2.5:1.5b",
      "settings": {}
    },
    "local_gemma": {
      "transport": "api",
      "engine": "local",
      "model": "gemma4-4b",
      "settings": {"temperature": 0.5, "max_tokens": 2000, "logprobs": true, "top_logprobs": 5}
    },
    "api_gemma31": {
      "transport": "api",
      "engine": "routerai",
      "model": "google/gemma-4-31b-it",
      "settings": {"temperature": 0.5, "max_tokens": 2000, "logprobs": true, "top_logprobs": 5}
    },
    "api_gemma26": {
      "transport": "api",
      "engine": "routerai",
      "model": "google/gemma-4-26b-a4b-it",
      "settings": {"temperature": 0.5, "max_tokens": 2000, "logprobs": true, "top_logprobs": 5,
                   "extra_body": {"provider": {"only": ["darkbloom"]}}}
    },
    "api_qwen38": {
      "transport": "api",
      "engine": "routerai",
      "model": "qwen/qwen3.8-27b",
      "settings": {"temperature": 0.5, "max_tokens": 2000, "logprobs": true, "top_logprobs": 5,
                   "extra_body": {"provider": {"only": ["primeintellect"]}}}
    }
  },
  "sandbox": {
    "paths": [
      "~/.claude/CLAUDE.md",
      "~/.claude/skills",
      "~/.claude/projects/c--Users-LeoLeon-Documents--------------------------------------------/memory"
    ],
    "disable_plugins": true
  }
}
